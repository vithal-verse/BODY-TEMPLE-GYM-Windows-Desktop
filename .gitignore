# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/playwright-report

# next.js
/.next/
/out/

# electron build output
/dist-electron/
/release/
/dist/

# production
/build/*
!/build/icon.ico
!/build/icon.png
!/build/installer-sidebar.bmp

# ---------------------------------------------------------------
# NEVER commit operational data. The live database lives in the
# Windows user's AppData folder, not in this repository.
# ---------------------------------------------------------------
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal
*.db
*.db-wal
*.db-shm
/backups/
/Backups/
/userData/
/data/
*.bak
*.backup
supabase-export/
member-export*.csv

# secrets / credentials
.env*
*.pem
*.key
*.p12
*.pfx
service-account*.json
google-credentials*.json

# misc
.DS_Store
Thumbs.db
*.log

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# typescript
*.tsbuildinfo
next-env.d.ts
.dev-data/
